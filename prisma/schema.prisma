generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  name     String
  // Defaults to USER (no capabilities) so public self-registration cannot
  // mint CRM access. Staff roles are only assigned by an admin.
  role     Role   @default(USER)
  // Set = deactivated: blocked at login and downgraded on token refresh.
  // Cleared = reactivated. Matches the soft-delete convention used elsewhere.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  assignments EventAssignment[]
}

model Participant {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  googleId  String    @unique
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bookings Booking[]
  payments Payment[]
}

enum Role {
  ADMIN
  STAFF
  MANAGER
  // Non-staff account (public sign-up). Holds no capability — see src/lib/rbac.ts.
  USER
  // Event organizer's team. Capabilities are event-scoped: they apply only to
  // events listed in EventAssignment — see src/lib/eventScope.ts.
  ORGANIZER
}

model Event {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  venue              String
  bookingDeadline    DateTime
  capacity           Int
  isOpen             Boolean  @default(true)
  image              String?
  genres             String[]
  baseTicketPrice    Int
  hasDiscount        Boolean
  discountPercentage Int
  discountUpto       DateTime

  // Number of tickets offered for sale (<= capacity; allows hold-backs).
  ticketsAvailable Int

  // Lyante's agreed cut of this event's net ticket sales, as a whole percent.
  // Varies per organizer, so it lives on the event rather than in config.
  // Nullable ONLY so events predating the field stay honestly "unset" — the
  // create/update schemas require it, and analytics renders unset as "—"
  // rather than implying 0% income. See src/lib/analytics.ts.
  commissionPercentage Int?
  status           EventStatus @default(DRAFT)
  eventType        EventType   @default(OTHER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id])

  tickets  Ticket[]
  bookings Booking[]
  payments Payment[]

  assignments EventAssignment[]
  activities  TicketActivity[]

  // bookingDeadline IS the event date: ordered by it on every listing and
  // filtered by it for "upcoming". status narrows the public listing.
  @@index([bookingDeadline])
  @@index([status])
  @@index([artistId])
}

/// Grants one staff account (in practice an ORGANIZER) access to one event.
/// Scope is the rows here; the role is on User. Cascade on the event side is
/// required — events are hard-deleted by DELETE /api/events/[eventId].
model EventAssignment {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

/// Append-only record of who did what to a ticket.
///
/// `ticketId`, `paymentId` and `actorId` are deliberately NOT foreign keys: a
/// log that cascades away with its subject, or that resolves "who" through a
/// join to a row someone later renamed, is not an audit log. Identity is
/// snapshotted as text at write time.
///
/// `eventId` IS a cascading FK — events are hard-deleted and take their tickets
/// with them, so per-event rows with no event and no viewer would be worse than
/// losing them.
model TicketActivity {
  id      String       @id @default(cuid())
  eventId String
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  action  TicketAction

  /// The exact ticket, for state changes. Null on aggregate creation rows.
  ticketId String?
  /// The payment, for refunds.
  paymentId String?
  /// Tickets covered by this entry. >1 only on aggregate rows.
  quantity Int @default(1)

  actorType ActorType
  actorId   String?
  /// Snapshot, e.g. "Sita Thapa <sita@lyante.art>". Never resolved by join.
  actorLabel String
  actorRole  String?

  /// Required on CANCELLED and REFUNDED.
  reason String?
  /// Refund amount, same unit as Payment.finalAmount.
  amount Int?
  /// Structured extras, e.g. { alreadyUsed: 1 } from a refund cascade.
  meta Json?

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([ticketId])
}

enum TicketAction {
  ISSUED
  PURCHASED
  SELF_REGISTERED
  SCANNED
  CANCELLED
  REFUNDED
  DELETED
}

enum ActorType {
  USER
  PARTICIPANT
  SYSTEM
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventType {
  CONCERT
  FESTIVAL
  CONFERENCE
  SPORTS
  PRIVATE
  OTHER
}

model Artist {
  id                String   @id @default(cuid())
  artistName        String
  artistImage       String
  artistBand        String
  artistDescription String
  artistGenere      String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  events Event[]
  musics Music[]
}

model Music {
  id         String @id @default(cuid())
  musicTitle String

  artistId String
  artist   Artist        @relation(fields: [artistId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([artistId])
}

model Payment {
  id String @id @default(cuid())

  totalAmount        Int
  discountAmount     Int
  discountPercentage Int
  finalAmount        Int

  paymentInitiatorId String
  paymentInitiator   Participant @relation(fields: [paymentInitiatorId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  paymentStatus PaymentStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  // Analytics groups payments by event and status; the sales trend scans PAID
  // payments in date order.
  @@index([eventId, paymentStatus])
  @@index([paymentStatus, createdAt])
  @@index([paymentInitiatorId])
}

enum PaymentStatus {
  PAID
  REFUND
  PENDING
  REJECTED
}

model Booking {
  id String @id @default(cuid())

  quantity Int
  status   bookingStatus @default(PENDING)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets   Ticket[]

  // All three are foreign keys joined on constantly — Postgres does not index
  // foreign keys automatically, and neither does Prisma.
  @@index([paymentId])
  @@index([eventId])
  @@index([participantId])
}

enum bookingStatus {
  PAID
  REFUND
  PENDING
  REJECTED
}

model Ticket {
  id    String @id @default(cuid())
  token String @unique @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  attendeeName    String?
  attendeeEmail   String?
  distributorName String?

  category  TicketCategory @default(GENERAL)
  status    TicketStatus   @default(UNUSED)
  source    TicketSource   @default(ADMIN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  checkIn CheckIn?

  // The sold-count aggregate (`groupBy eventId where status != CANCELLED`) runs
  // on every public /events view; without this it sequentially scans the whole
  // table. The composite also serves plain eventId lookups via its leftmost
  // column, so no separate eventId index is needed.
  @@index([eventId, status])
  @@index([bookingId])
  // "My Tickets" matches on the buyer's email as well as their bookings.
  @@index([attendeeEmail])
}

enum TicketCategory {
  GENERAL
  VIP
}

enum TicketStatus {
  UNUSED
  USED
  CANCELLED
}

enum TicketSource {
  ADMIN
  SELF_REGISTERED
}

model CheckIn {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  scannedAt DateTime @default(now())
  createdAt DateTime @default(now())

  // Check-in timelines read scans in chronological order.
  @@index([scannedAt])
}
